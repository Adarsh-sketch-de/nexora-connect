PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Storage: local works immediately. Use mysql for a real MySQL database.
DB_MODE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=connect

# Email delivery (Resend). Verification/reset codes are never shown on the site.
RESEND_API_KEY=
EMAIL_FROM=Connect <onboarding@resend.dev>

# WebRTC TURN relay for reliable calls across different networks.
TURN_URLS=turn:your-turn-server:3478,turns:your-turn-server:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional real AI summaries. Without this key Connect uses a concise local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin demo credentials. Change these before deployment.
ADMIN_EMAIL=admin@connect.local
ADMIN_PASSWORD=ConnectAdmin@2026!

# Google OAuth is intentionally not faked. Add a real provider before production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
