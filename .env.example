PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Storage: local works immediately. Use mysql for a real MySQL database.
DB_MODE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nexora_connect

# Optional SMTP for real password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nexora Connect <no-reply@nexora.local>

# Admin demo credentials. Change these before deployment.
ADMIN_EMAIL=admin@nexora.local
ADMIN_PASSWORD=Admin@12345

# Google OAuth is intentionally not faked. Add a real provider before production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
